<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN">
{% set contentLegacySize = 4 if isNS4 else 3 %}
{% set navigationLegacySize = 3 if isNS4 else 2 %}
<html>
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title | escape }}</title>

  <style type="text/css">
    body, td {
     background-color: #f7f3e8;
     color: #292929;
     font-size: {{ '20px' if isNS4 else fontSize }};
     font-family: {{ fontFamily }};
    }
    .browser-navigation, .browser-navigation td, input {
      font-family: Verdana, Arial, Helvetica, sans-serif;
       font-size: {{ '16px' if isNS4 else '12px' }};
    }
    ul {
      list-style-type: none;
    }
    @media screen and (max-width: 9000px) {
      body {
        margin: 0;
        padding: 10px;
      }
      table {
        width: 100%;
        max-width: 100%;
        border-collapse: collapse;
      }
      .browser-url {
        width: 80%;
        max-width: 600px;
         font-size: {{ '16px' if isNS4 else '12px' }};
        box-sizing: border-box;
      }
    }
  </style>
</head>

<body bgcolor="#f7f3e8" text="#292929" link="#174a7e" vlink="#551a8b" alink="#ff0000">
<font face="{{ fontFamily }}" size="{{ contentLegacySize }}">

{# ------------------------- Toolbar ------------------------- #}
<table width="100%" cellpadding="2" cellspacing="0" border="0">
  <tr>
    <td align="left" width="100%">
      <form action="/browser/browse" method="get">
        <input class="browser-url"
               type="text"
               name="url"
               size="{{ 50 if isNS4 else 120 }}"
               value="{{ url | default('') | escape }}">
        <input type="submit" value="Öffnen">
      </form>
    </td>

    <td align="left" valign="middle">
      <form action="/browser/search" method="get"
            onsubmit="this.url.value = document.getElementsByTagName('form')[0].elements[0].value;">
        <input type="hidden" name="url">
        <input type="submit" value="Suchen">
      </form>
    </td>

    <td align="right" valign="middle">
      <form action="/" method="get">
        <input type="submit" value="Schließen">
      </form>
    </td>
  </tr>
</table>

<hr>

{# ---------------------- Page Content ----------------------- #}

{% set hasUrl = url and url != '' %}
{% set headerBg = fallbackColor %}
{% set navBg = fallbackColor %}

{% if isSearch %}
  {% include "browser/partials/search.ns4" %}
{% else %}
  {% include "browser/partials/browse.ns4" %}
{% endif %}

</font>
</body>
</html>
