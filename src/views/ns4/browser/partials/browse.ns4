<table width="100%" cellpadding="8" cellspacing="0" border="0">

  {# Header Row #}
  <tr>
    <td colspan="2" align="left">
      <b>{{ title | escape }}</b><br>
      <small>
        {% if hasUrl %}
          Original: <a href="{{ url | escape }}">{{ url | escape }}</a>
        {% else %}
          Bitte gib eine URL ein.
        {% endif %}
      </small>
      <hr>
    </td>
  </tr>

  {# Navigation + Content #}
  {% if hasUrl %}
  <tr>
    <td class="browser-navigation" width="180" valign="top" bgcolor="{{ navBg }}" style="border-right: 1px solid #cccccc;">
      <font face="Verdana, Arial, Helvetica, sans-serif" size="{{ navigationLegacySize }}" color="{{ textColor or '#292929' }}">
      <b>Navigation</b>
      <hr>
      {% if navHtml %}
        {{ navHtml | safe }}
      {% else %}
        <small>Keine Navigation erkannt.</small>
      {% endif %}
      </font>
    </td>

    <td valign="top" align="center">
      <table width="100%" cellpadding="4" cellspacing="0" border="0" style="max-width: 850px;">
        <tr><td valign="top" align="left" bgcolor="{{ fallbackColor }}"><font face="{{ fontFamily }}" size="{{ contentLegacySize }}" color="{{ textColor or '#292929' }}">{{ contentHtml | safe }}</font></td></tr>
      </table>
    </td>
  </tr>
  {% endif %}

</table>
