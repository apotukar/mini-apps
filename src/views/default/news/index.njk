{% extends "layout.njk" %}

{% set style = "common, news" %}

{% block title %}News{% endblock %}

{% block content %}

  {% if isNS4 %}
  <table width="560" align="center" border="0" cellpadding="6" cellspacing="0">
    <tr><td align="left">
  {% endif %}

  {% if isNS4 %}
  <table border="0" cellpadding="0" cellspacing="0">
    <tr><td width="20">&nbsp;</td><td align="left">
  {% endif %}
  <h2>News</h2>
  {% if isNS4 %}
    </td></tr>
  </table>
  {% endif %}

  <form method="get" action="/news">
    {% if isNS4 %}
    <table border="0" cellpadding="0" cellspacing="0">
      <tr><td width="40">&nbsp;</td><td align="left">
    {% endif %}
    <label for="proxy">Links-Proxy:</label>

    <select id="proxy" name="proxy">
      <option value="" {% if not currentProxy %}selected{% endif %}>
          Original-Links
      </option>

      {% for p in proxies %}
        <option value="{{ p.link }}"
          {% if p.link == currentProxy %}selected{% endif %}>
          {{ p.description }}
        </option>
      {% endfor %}
    </select>

    {% if viewExt == 'ns4' %}
    <input type="submit" value="Links neu laden">
    {% else %}
    <button type="submit">Links neu laden</button>
    {% endif %}
    {% if isNS4 %}
      </td></tr>
    </table>
    {% endif %}
  </form>

  <br>

  <ul>
    {% for item in items %}
      <li>
        <a href="{{ item.link }}"{% if item.color %} style="color: {{ item.color }};"{% endif %}>{{ item.title }}</a><br>
        {% if item.date %}
          <small>{{ item.date | formatWeekday }} {{ item.date | formatDateTime }}</small><br>
        {% endif %}
        {% if item.description %}
          <small>{{ item.description | safe }}</small>
        {% endif %}
        <span class="source-label">{{ item.source }}</span>
      </li>
    {% endfor %}
  </ul>

  <p class="hint">
  Vereinfachte Darstellung der Schlagzeilen aus mehreren Quellen.
  </p>

  {% if isNS4 %}
    </td></tr>
  </table>
  {% endif %}

{% endblock %}
